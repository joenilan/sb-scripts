<Window x:Class="Crntly.StreamerBot.UI.Overlayer.OverlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="CRNTLY • Overlayer"
        Width="1040" Height="720" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Crntly.Background}"
        Foreground="{DynamicResource Crntly.Text}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemeResources />
        <ui:FluentControlsResources UseCompactResources="False" />
        <ResourceDictionary Source="/CRNTLY.StreamerBot.UI;component/Theme/CrntlyTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <!-- Keep window chrome local to CRNTLY rather than changing Streamer.bot's app-level theme. -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0"
                        ResizeBorderThickness="6"
                        CornerRadius="10"
                        GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>

  <Border Background="{StaticResource Crntly.Background}"
          BorderBrush="{StaticResource Crntly.Border}"
          BorderThickness="1"
          CornerRadius="10">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="52" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="32" />
      </Grid.RowDefinitions>

      <!-- title bar -->
      <Border Grid.Row="0"
              Background="{StaticResource Crntly.Surface}"
              BorderBrush="{StaticResource Crntly.Border}"
              BorderThickness="0,0,0,1"
              CornerRadius="10,10,0,0"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="16,0,8,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="38" />
            <ColumnDefinition Width="38" />
          </Grid.ColumnDefinitions>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="26" Height="26"
                    Background="{StaticResource Crntly.AccentMuted}"
                    BorderBrush="{StaticResource Crntly.Accent}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Margin="0,0,10,0">
              <TextBlock Text="C" Foreground="{StaticResource Crntly.Accent}"
                         FontWeight="Bold" FontSize="12"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel>
              <TextBlock Text="Overlayer" FontWeight="SemiBold" FontSize="13"
                         Foreground="{StaticResource Crntly.Text}" />
              <TextBlock Text="CRNTLY" FontWeight="SemiBold" FontSize="9"
                         Foreground="{StaticResource Crntly.TextSubtle}" />
            </StackPanel>
          </StackPanel>

          <Border Grid.Column="1" x:Name="ServerBadge"
                  Background="{StaticResource Crntly.SurfaceRaised}"
                  BorderBrush="{StaticResource Crntly.Border}"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="10,4" Margin="0,0,9,0"
                  VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="ServerDot" Width="6" Height="6"
                       Fill="{StaticResource Crntly.TextSubtle}" Margin="0,0,7,0" />
              <TextBlock x:Name="ServerBadgeText" Text="SERVER OFFLINE"
                         FontSize="9" FontWeight="SemiBold"
                         Foreground="{StaticResource Crntly.TextMuted}" />
            </StackPanel>
          </Border>

          <Button Grid.Column="2" Content="—"
                  Style="{StaticResource Crntly.TitleButton}"
                  Margin="2" Click="Minimize_Click"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" />
          <Button Grid.Column="3" Content="×"
                  Style="{StaticResource Crntly.TitleButton}"
                  Margin="2" Click="Close_Click"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" />
        </Grid>
      </Border>

      <!-- compositor control bar -->
      <Border Grid.Row="1" Style="{StaticResource Crntly.Card}"
              Margin="16,14,16,10" Padding="12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Button x:Name="ServerButton" Grid.Column="0" Content="Start server"
                  Style="{StaticResource Crntly.PrimaryButton}"
                  Click="ServerButton_Click" MinWidth="120" />

          <StackPanel Grid.Column="2">
            <TextBlock Text="OBS Browser Source" Style="{StaticResource Crntly.Label}" Margin="1,0,0,4" />
            <TextBox x:Name="ServerUrlBox" IsReadOnly="True"
                     Style="{StaticResource Crntly.ReadOnlyTextBox}"
                     Text="http://localhost:42069/"
                     VerticalContentAlignment="Center" />
          </StackPanel>

          <Button Grid.Column="4" Content="Copy URL"
                  Style="{StaticResource Crntly.Button}"
                  Click="CopyUrl_Click" MinWidth="82"
                  VerticalAlignment="Bottom" />
        </Grid>
      </Border>

      <!-- main workspace -->
      <Grid Grid.Row="2" Margin="16,0,16,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="330" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- overlays -->
        <Border Grid.Column="0" Style="{StaticResource Crntly.Card}" Padding="12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="44" />
              <RowDefinition Height="*" />
              <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Overlays" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="One source, many layers"
                           Foreground="{StaticResource Crntly.TextSubtle}" FontSize="10" Margin="0,2,0,0" />
              </StackPanel>
              <Button Content="+  Add" Style="{StaticResource Crntly.Button}"
                      Padding="11,5" MinHeight="30"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Click="Add_Click" />
            </Grid>

            <ListBox Grid.Row="1" x:Name="OverlayList"
                     Style="{StaticResource Crntly.OverlayList}"
                     ItemContainerStyle="{StaticResource Crntly.OverlayListItem}"
                     SelectionChanged="OverlayList_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="26" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Checked="OverlayEnabledChanged" Unchecked="OverlayEnabledChanged"
                              VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Url}"
                                 Foreground="{StaticResource Crntly.TextSubtle}" FontSize="9"
                                 Margin="0,3,8,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            Background="{StaticResource Crntly.SurfaceRaised}"
                            CornerRadius="5" Padding="6,3"
                            VerticalAlignment="Top">
                      <TextBlock Text="{Binding SourceKind}"
                                 Foreground="{StaticResource Crntly.TextMuted}"
                                 FontSize="8" FontWeight="SemiBold" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="2" Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Content="↑  Up"
                      Style="{StaticResource Crntly.Button}" Padding="8,5"
                      Margin="0,0,4,0" Click="MoveUp_Click" />
              <Button Grid.Column="1" Content="↓  Down"
                      Style="{StaticResource Crntly.Button}" Padding="8,5"
                      Margin="4,0" Click="MoveDown_Click" />
              <Button Grid.Column="2" Content="Delete"
                      Style="{StaticResource Crntly.DangerButton}" Padding="8,5"
                      Margin="4,0,0,0" Click="Delete_Click" />
            </Grid>
          </Grid>
        </Border>

        <!-- selected overlay editor -->
        <Border Grid.Column="2" Style="{StaticResource Crntly.Card}" Padding="18">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <Grid Margin="0,0,0,18">
                <StackPanel>
                  <TextBlock Text="Overlay settings" FontWeight="SemiBold" FontSize="17" />
                  <TextBlock Text="Changes preview live and save automatically."
                             Foreground="{StaticResource Crntly.TextSubtle}"
                             FontSize="10" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Ellipse x:Name="EditorStatusDot" Width="6" Height="6"
                           Fill="{StaticResource Crntly.TextSubtle}" Margin="0,0,7,0" />
                  <TextBlock x:Name="EditorStatusText" Text="Autosave"
                             Foreground="{StaticResource Crntly.TextMuted}" FontSize="10" />
                </StackPanel>
              </Grid>

              <TextBlock Text="NAME" Style="{StaticResource Crntly.Label}" Margin="0,0,0,5" />
              <TextBox x:Name="NameBox" Style="{StaticResource Crntly.TextBox}"
                       Margin="0,0,0,14" TextChanged="EditorField_TextChanged" />

              <TextBlock Text="URL OR LOCAL FILE URL" Style="{StaticResource Crntly.Label}" Margin="0,0,0,5" />
              <TextBox x:Name="UrlBox" Style="{StaticResource Crntly.TextBox}"
                       Margin="0,0,0,16" TextChanged="EditorField_TextChanged" />

              <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="WIDTH" Style="{StaticResource Crntly.Label}" Margin="0,0,0,5" />
                  <TextBox x:Name="WidthBox" Style="{StaticResource Crntly.TextBox}"
                           TextChanged="EditorField_TextChanged" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="HEIGHT" Style="{StaticResource Crntly.Label}" Margin="0,0,0,5" />
                  <TextBox x:Name="HeightBox" Style="{StaticResource Crntly.TextBox}"
                           TextChanged="EditorField_TextChanged" />
                </StackPanel>
              </Grid>

              <Border Style="{StaticResource Crntly.SubtleCard}" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="Position" FontWeight="SemiBold" FontSize="12" />
                  <TextBlock Text="Drag for live movement in OBS, or enter an exact pixel value."
                             Foreground="{StaticResource Crntly.TextSubtle}" FontSize="9"
                             Margin="0,3,0,14" />

                  <!-- X -->
                  <Grid Margin="0,0,0,13">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="24" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="10" />
                      <ColumnDefinition Width="82" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="X" FontWeight="SemiBold"
                               Foreground="{StaticResource Crntly.TextMuted}"
                               VerticalAlignment="Center" />
                    <Slider Grid.Column="1" x:Name="LeftSlider"
                            Minimum="-1920" Maximum="3840" SmallChange="1" LargeChange="50"
                            IsMoveToPointEnabled="True" VerticalAlignment="Center"
                            ValueChanged="PositionSlider_ValueChanged"
                            ToolTip="X position in pixels. Range: -1920 to 3840." />
                    <TextBox Grid.Column="3" x:Name="LeftBox"
                             Style="{StaticResource Crntly.TextBox}"
                             TextAlignment="Right"
                             TextChanged="EditorField_TextChanged" />
                  </Grid>

                  <!-- Y -->
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="24" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="10" />
                      <ColumnDefinition Width="82" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Y" FontWeight="SemiBold"
                               Foreground="{StaticResource Crntly.TextMuted}"
                               VerticalAlignment="Center" />
                    <Slider Grid.Column="1" x:Name="TopSlider"
                            Minimum="-1080" Maximum="2160" SmallChange="1" LargeChange="50"
                            IsMoveToPointEnabled="True" VerticalAlignment="Center"
                            ValueChanged="PositionSlider_ValueChanged"
                            ToolTip="Y position in pixels. Range: -1080 to 2160." />
                    <TextBox Grid.Column="3" x:Name="TopBox"
                             Style="{StaticResource Crntly.TextBox}"
                             TextAlignment="Right"
                             TextChanged="EditorField_TextChanged" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Crntly.SubtleCard}" Padding="12">
                <Grid>
                  <StackPanel>
                    <TextBlock Text="Visible in compositor" FontWeight="SemiBold" FontSize="11" />
                    <TextBlock Text="Toggle takes effect immediately."
                               Foreground="{StaticResource Crntly.TextSubtle}" FontSize="9" Margin="0,2,0,0" />
                  </StackPanel>
                  <CheckBox x:Name="EnabledBox" Content="Enabled"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Checked="EditorEnabledChanged" Unchecked="EditorEnabledChanged" />
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <Grid Grid.Row="3" Margin="17,0">
        <TextBlock Text="CRNTLY  •  livestreaming.tools"
                   Foreground="{StaticResource Crntly.TextSubtle}" FontSize="9"
                   VerticalAlignment="Center" />
        <TextBlock Text="single-browser-source compositor"
                   Foreground="{StaticResource Crntly.TextSubtle}" FontSize="9"
                   HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
    </Grid>
  </Border>
</Window>
