<Window x:Class="Crntly.StreamerBot.UI.Overlayer.OverlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CRNTLY • Overlayer"
        Width="820" Height="500" MinWidth="740" MinHeight="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Crntly.Background}">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CRNTLY.StreamerBot.UI;component/Theme/CrntlyTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0"
                        ResizeBorderThickness="5"
                        CornerRadius="8"
                        GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>

  <Border Background="{DynamicResource Crntly.Background}"
          BorderBrush="{DynamicResource Crntly.Border}"
          BorderThickness="1"
          CornerRadius="{StaticResource Crntly.WindowRadius}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="{StaticResource Crntly.TitleBarHeight}" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="22" />
      </Grid.RowDefinitions>

      <!-- title bar -->
      <Border Grid.Row="0"
              Background="{DynamicResource Crntly.Surface}"
              BorderBrush="{DynamicResource Crntly.Border}"
              BorderThickness="0,0,0,1"
              CornerRadius="8,8,0,0"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="10,0,6,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="30" />
          </Grid.ColumnDefinitions>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="22" Height="22"
                    Background="{DynamicResource Crntly.AccentMuted}"
                    BorderBrush="{DynamicResource Crntly.Accent}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Margin="0,0,7,0">
              <TextBlock Text="C" Foreground="{DynamicResource Crntly.Accent}"
                         FontWeight="Bold" FontSize="10"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Overlayer" Foreground="{DynamicResource Crntly.Text}"
                       FontWeight="SemiBold" FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Text="  ·  CRNTLY" Foreground="{DynamicResource Crntly.TextSubtle}"
                       FontWeight="SemiBold" FontSize="9"
                       VerticalAlignment="Center" />
          </StackPanel>

          <Border Grid.Column="1" x:Name="ServerBadge"
                  Background="{DynamicResource Crntly.SurfaceRaised}"
                  BorderBrush="{DynamicResource Crntly.Border}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="7,3" Margin="0,0,6,0"
                  VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="ServerDot" Width="5" Height="5"
                       Fill="{DynamicResource Crntly.TextMuted}" Margin="0,0,5,0" />
              <TextBlock x:Name="ServerBadgeText" Text="SERVER OFFLINE"
                         Foreground="{DynamicResource Crntly.TextMuted}"
                         FontSize="8" FontWeight="SemiBold" />
            </StackPanel>
          </Border>

          <Button Grid.Column="2" Content="—"
                  Style="{StaticResource Crntly.TitleButton}"
                  Click="Minimize_Click"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" />
          <Button Grid.Column="3" Content="×"
                  Style="{StaticResource Crntly.TitleButton}"
                  Click="Close_Click"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" />
        </Grid>
      </Border>

      <!-- compositor connection -->
      <Border Grid.Row="1" Style="{StaticResource Crntly.Card}"
              Margin="10,8,10,6" Padding="8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Button x:Name="ServerButton" Grid.Column="0" Content="Start server"
                  Style="{StaticResource Crntly.PrimaryButton}"
                  Click="ServerButton_Click" MinWidth="96" />

          <TextBox x:Name="ServerUrlBox" Grid.Column="2" IsReadOnly="True"
                   Text="http://localhost:42069/"
                   VerticalContentAlignment="Center" />

          <Button Grid.Column="4" Content="Copy"
                  Style="{StaticResource Crntly.CompactButton}"
                  Click="CopyUrl_Click" MinWidth="52"
                  VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- workspace -->
      <Grid Grid.Row="2" Margin="10,0,10,7">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="250" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- overlay list -->
        <Border Grid.Column="0" Style="{StaticResource Crntly.Card}" Padding="8">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="34" />
              <RowDefinition Height="*" />
              <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
              <TextBlock Text="Overlays" Foreground="{DynamicResource Crntly.Text}"
                         FontWeight="SemiBold" FontSize="12"
                         VerticalAlignment="Center" />
              <Button Content="+ Add"
                      Style="{StaticResource Crntly.CompactButton}"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Click="Add_Click" />
            </Grid>

            <ListBox Grid.Row="1" x:Name="OverlayList"
                     SelectionChanged="OverlayList_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="35" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Checked="OverlayEnabledChanged" Unchecked="OverlayEnabledChanged"
                              VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Crntly.Text}"
                                 FontWeight="SemiBold" FontSize="10"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Url}"
                                 Foreground="{DynamicResource Crntly.TextSubtle}"
                                 FontSize="8" Margin="0,1,6,0"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding SourceKind}"
                               Foreground="{DynamicResource Crntly.TextSubtle}"
                               FontSize="7" FontWeight="SemiBold"
                               VerticalAlignment="Top" Margin="4,1,0,0" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="2" Margin="0,5,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Content="↑ Up"
                      Style="{StaticResource Crntly.CompactButton}"
                      Margin="0,0,3,0" Click="MoveUp_Click" />
              <Button Grid.Column="1" Content="↓ Down"
                      Style="{StaticResource Crntly.CompactButton}"
                      Margin="3,0" Click="MoveDown_Click" />
              <Button Grid.Column="2" Content="Delete"
                      Style="{StaticResource Crntly.DangerButton}"
                      Padding="7,3" MinHeight="24"
                      Margin="3,0,0,0" Click="Delete_Click" />
            </Grid>
          </Grid>
        </Border>

        <!-- editor -->
        <Border Grid.Column="2" Style="{StaticResource Crntly.Card}" Padding="10">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,0">
              <!-- editor header: status + enabled live here instead of consuming another card -->
              <Grid Margin="0,0,0,9">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="Overlay settings"
                             Foreground="{DynamicResource Crntly.Text}"
                             FontWeight="SemiBold" FontSize="14" />
                  <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Ellipse x:Name="EditorStatusDot" Width="5" Height="5"
                             Fill="{DynamicResource Crntly.TextMuted}" Margin="0,0,5,0" />
                    <TextBlock x:Name="EditorStatusText" Text="Autosave"
                               Foreground="{DynamicResource Crntly.TextMuted}"
                               FontSize="8" />
                  </StackPanel>
                </StackPanel>

                <CheckBox x:Name="EnabledBox" Content="Enabled"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Checked="EditorEnabledChanged"
                          Unchecked="EditorEnabledChanged" />
              </Grid>

              <!-- identity row -->
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="0.34*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="0.66*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="NAME" Style="{StaticResource Crntly.Label}" Margin="0,0,0,3" />
                  <TextBox x:Name="NameBox" TextChanged="EditorField_TextChanged" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="URL / LOCAL FILE" Style="{StaticResource Crntly.Label}" Margin="0,0,0,3" />
                  <TextBox x:Name="UrlBox" TextChanged="EditorField_TextChanged" />
                </StackPanel>
              </Grid>

              <!-- size row -->
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="WIDTH" Style="{StaticResource Crntly.Label}" Margin="0,0,0,3" />
                  <TextBox x:Name="WidthBox" TextChanged="EditorField_TextChanged" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="HEIGHT" Style="{StaticResource Crntly.Label}" Margin="0,0,0,3" />
                  <TextBox x:Name="HeightBox" TextChanged="EditorField_TextChanged" />
                </StackPanel>
              </Grid>

              <!-- position -->
              <Border Style="{StaticResource Crntly.SubtleCard}" Padding="9">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Position" Foreground="{DynamicResource Crntly.Text}"
                               FontWeight="SemiBold" FontSize="10" />
                    <TextBlock Text="  ·  live preview"
                               Foreground="{DynamicResource Crntly.TextSubtle}"
                               FontSize="8" VerticalAlignment="Center" />
                  </StackPanel>

                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="8" />
                      <ColumnDefinition Width="68" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="X"
                               Foreground="{DynamicResource Crntly.TextMuted}"
                               FontWeight="SemiBold" FontSize="9"
                               VerticalAlignment="Center" />
                    <Slider Grid.Column="1" x:Name="LeftSlider"
                            Minimum="-1920" Maximum="3840"
                            SmallChange="1" LargeChange="50"
                            IsMoveToPointEnabled="True"
                            VerticalAlignment="Center"
                            ValueChanged="PositionSlider_ValueChanged"
                            ToolTip="X position in pixels. Range: -1920 to 3840." />
                    <TextBox Grid.Column="3" x:Name="LeftBox"
                             TextAlignment="Right"
                             TextChanged="EditorField_TextChanged" />
                  </Grid>

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="8" />
                      <ColumnDefinition Width="68" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Y"
                               Foreground="{DynamicResource Crntly.TextMuted}"
                               FontWeight="SemiBold" FontSize="9"
                               VerticalAlignment="Center" />
                    <Slider Grid.Column="1" x:Name="TopSlider"
                            Minimum="-1080" Maximum="2160"
                            SmallChange="1" LargeChange="50"
                            IsMoveToPointEnabled="True"
                            VerticalAlignment="Center"
                            ValueChanged="PositionSlider_ValueChanged"
                            ToolTip="Y position in pixels. Range: -1080 to 2160." />
                    <TextBox Grid.Column="3" x:Name="TopBox"
                             TextAlignment="Right"
                             TextChanged="EditorField_TextChanged" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <Grid Grid.Row="3" Margin="11,0">
        <TextBlock Text="CRNTLY  •  livestreaming.tools"
                   Foreground="{DynamicResource Crntly.TextSubtle}"
                   FontSize="8" VerticalAlignment="Center" />
        <TextBlock Text="single-browser-source compositor"
                   Foreground="{DynamicResource Crntly.TextSubtle}"
                   FontSize="8" HorizontalAlignment="Right"
                   VerticalAlignment="Center" />
      </Grid>
    </Grid>
  </Border>
</Window>
