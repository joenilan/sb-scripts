<Window x:Class="Crntly.StreamerBot.UI.Overlayer.OverlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CRNTLY • Overlayer"
        Width="980" Height="680" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Crntly.Background}">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CRNTLY.StreamerBot.UI;component/Theme/CrntlyTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0"
                        ResizeBorderThickness="6"
                        CornerRadius="10"
                        GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>

  <Border Background="{StaticResource Crntly.Background}"
          BorderBrush="{StaticResource Crntly.Border}"
          BorderThickness="1"
          CornerRadius="10">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="48" />
        <RowDefinition Height="58" />
        <RowDefinition Height="*" />
        <RowDefinition Height="34" />
      </Grid.RowDefinitions>

      <!-- title bar -->
      <Border Grid.Row="0" Background="{StaticResource Crntly.Surface}" CornerRadius="10,10,0,0"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="16,0,8,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="34" />
            <ColumnDefinition Width="34" />
          </Grid.ColumnDefinitions>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="CRNTLY" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Crntly.Text}" />
            <TextBlock Text="  /  OVERLAYER" FontSize="12" Foreground="{StaticResource Crntly.TextMuted}" />
          </StackPanel>

          <Border Grid.Column="1" x:Name="ServerBadge" Background="#272A31" CornerRadius="12"
                  Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="ServerDot" Width="7" Height="7" Fill="{StaticResource Crntly.TextMuted}" Margin="0,0,7,0" />
              <TextBlock x:Name="ServerBadgeText" Text="SERVER OFFLINE" FontSize="10" FontWeight="SemiBold"
                         Foreground="{StaticResource Crntly.TextMuted}" />
            </StackPanel>
          </Border>

          <Button Grid.Column="2" Content="—" Style="{StaticResource Crntly.Button}" Padding="0"
                  Margin="2" Click="Minimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
          <Button Grid.Column="3" Content="×" Style="{StaticResource Crntly.Button}" Padding="0"
                  Margin="2" Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
        </Grid>
      </Border>

      <!-- server controls -->
      <Grid Grid.Row="1" Margin="16,10,16,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="145" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="80" />
        </Grid.ColumnDefinitions>
        <Button x:Name="ServerButton" Grid.Column="0" Content="Start server"
                Style="{StaticResource Crntly.PrimaryButton}" Click="ServerButton_Click" Margin="0,0,10,0" />
        <TextBox x:Name="ServerUrlBox" Grid.Column="1" IsReadOnly="True" Text="http://localhost:42069/"
                 VerticalContentAlignment="Center" Foreground="{StaticResource Crntly.TextMuted}" />
        <Button Grid.Column="2" Content="Copy" Style="{StaticResource Crntly.Button}" Click="CopyUrl_Click" Margin="10,0,0,0" />
      </Grid>

      <!-- main content -->
      <Grid Grid.Row="2" Margin="16,4,16,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="350" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- overlay list -->
        <Border Grid.Column="0" Style="{StaticResource Crntly.Card}" Padding="12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="44" />
              <RowDefinition Height="*" />
              <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
              <TextBlock Text="Overlays" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
              <Button Content="+ Add" Style="{StaticResource Crntly.Button}" Padding="10,5"
                      HorizontalAlignment="Right" Click="Add_Click" />
            </Grid>

            <ListBox Grid.Row="1" x:Name="OverlayList" SelectionChanged="OverlayList_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="28" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Checked="OverlayEnabledChanged" Unchecked="OverlayEnabledChanged" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Url}" Foreground="{StaticResource Crntly.TextMuted}" FontSize="10"
                                 Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding SourceKind}" Foreground="{StaticResource Crntly.TextMuted}"
                               FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Top" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="2" Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Content="↑ Up" Style="{StaticResource Crntly.Button}" Padding="8,5" Margin="0,0,4,0" Click="MoveUp_Click" />
              <Button Grid.Column="1" Content="↓ Down" Style="{StaticResource Crntly.Button}" Padding="8,5" Margin="4,0" Click="MoveDown_Click" />
              <Button Grid.Column="2" Content="Delete" Style="{StaticResource Crntly.Button}" Padding="8,5" Margin="4,0,0,0" Click="Delete_Click" />
            </Grid>
          </Grid>
        </Border>

        <!-- editor -->
        <Border Grid.Column="2" Style="{StaticResource Crntly.Card}" Padding="18">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="44" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
              <TextBlock Text="Overlay settings" FontWeight="SemiBold" FontSize="17" />
              <TextBlock Text="Changes save automatically after you stop editing." Foreground="{StaticResource Crntly.TextMuted}" FontSize="11" Margin="0,4,0,0" />
            </StackPanel>

            <TextBlock Grid.Row="1" Text="Name" Foreground="{StaticResource Crntly.TextMuted}" FontSize="11" Margin="0,0,0,5" />
            <TextBox Grid.Row="2" x:Name="NameBox" Margin="0,0,0,12" TextChanged="EditorField_TextChanged" />

            <StackPanel Grid.Row="3" Margin="0,0,0,12">
              <TextBlock Text="URL or local file URL" Foreground="{StaticResource Crntly.TextMuted}" FontSize="11" Margin="0,0,0,5" />
              <TextBox x:Name="UrlBox" TextChanged="EditorField_TextChanged" />
            </StackPanel>

            <Grid Grid.Row="4" Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Width" Foreground="{StaticResource Crntly.TextMuted}" FontSize="11" Margin="0,0,0,5" />
                <TextBox x:Name="WidthBox" TextChanged="EditorField_TextChanged" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Height" Foreground="{StaticResource Crntly.TextMuted}" FontSize="11" Margin="0,0,0,5" />
                <TextBox x:Name="HeightBox" TextChanged="EditorField_TextChanged" />
              </StackPanel>
            </Grid>

            <Grid Grid.Row="5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Left (x) · px" Foreground="{StaticResource Crntly.TextMuted}" FontSize="11" Margin="0,0,0,5" />
                <TextBox x:Name="LeftBox" TextChanged="EditorField_TextChanged" />
                <Slider x:Name="LeftSlider" Minimum="-1920" Maximum="3840" SmallChange="1" LargeChange="50"
                        IsMoveToPointEnabled="True" Margin="0,8,0,0" ValueChanged="PositionSlider_ValueChanged"
                        ToolTip="X position in pixels. Range: -1920 to 3840." />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Top (y) · px" Foreground="{StaticResource Crntly.TextMuted}" FontSize="11" Margin="0,0,0,5" />
                <TextBox x:Name="TopBox" TextChanged="EditorField_TextChanged" />
                <Slider x:Name="TopSlider" Minimum="-1080" Maximum="2160" SmallChange="1" LargeChange="50"
                        IsMoveToPointEnabled="True" Margin="0,8,0,0" ValueChanged="PositionSlider_ValueChanged"
                        ToolTip="Y position in pixels. Range: -1080 to 2160." />
              </StackPanel>
            </Grid>

            <Grid Grid.Row="7">
              <CheckBox x:Name="EnabledBox" Content="Enabled" VerticalAlignment="Center"
                        Checked="EditorEnabledChanged" Unchecked="EditorEnabledChanged" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse x:Name="EditorStatusDot" Width="7" Height="7" Fill="{StaticResource Crntly.TextMuted}" Margin="0,0,7,0" />
                <TextBlock x:Name="EditorStatusText" Text="Autosave" Foreground="{StaticResource Crntly.TextMuted}" FontSize="11" />
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <Grid Grid.Row="3" Margin="16,0">
        <TextBlock Text="CRNTLY • livestreaming.tools" Foreground="{StaticResource Crntly.TextMuted}" FontSize="10" VerticalAlignment="Center" />
        <TextBlock Text="single-browser-source compositor" Foreground="{StaticResource Crntly.TextMuted}" FontSize="10"
                   HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
    </Grid>
  </Border>
</Window>
