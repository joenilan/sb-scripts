<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Shared dependency-free CRNTLY controls. Theme/density tokens stay dynamic. -->

  <Style TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource Crntly.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource Crntly.Text}" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="{DynamicResource Crntly.FontSize}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="Crntly.Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Crntly.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Crntly.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Crntly.CardRadius}" />
  </Style>

  <Style x:Key="Crntly.SubtleCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Crntly.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Crntly.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Crntly.ControlRadius}" />
  </Style>

  <Style x:Key="Crntly.Label" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Crntly.TextMuted}" />
    <Setter Property="FontSize" Value="{DynamicResource Crntly.SmallFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="Crntly.Button" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Crntly.Text}" />
    <Setter Property="Background" Value="{DynamicResource Crntly.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Crntly.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="{DynamicResource Crntly.ButtonPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource Crntly.ControlHeight}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="{DynamicResource Crntly.FontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource Crntly.ControlRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Crntly.AccentMuted}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Crntly.Accent}" />
              <Setter Property="Foreground" Value="{DynamicResource Crntly.AccentHover}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Crntly.Accent}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Crntly.AccentPressed}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Crntly.AccentPressed}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.34" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Crntly.CompactButton" TargetType="Button" BasedOn="{StaticResource Crntly.Button}">
    <Setter Property="Padding" Value="{DynamicResource Crntly.CompactButtonPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource Crntly.SmallControlHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource Crntly.SmallFontSize}" />
  </Style>

  <Style x:Key="Crntly.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Crntly.Button}">
    <Setter Property="Background" Value="{DynamicResource Crntly.Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Crntly.Accent}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource Crntly.ControlRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Crntly.AccentHover}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Crntly.AccentHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Crntly.AccentPressed}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Crntly.AccentPressed}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="White" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.34" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Crntly.DangerButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Crntly.Danger}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Crntly.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="{DynamicResource Crntly.ButtonPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource Crntly.ControlHeight}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="{DynamicResource Crntly.FontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource Crntly.ControlRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Crntly.DangerMuted}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Crntly.Danger}" />
              <Setter Property="Foreground" Value="{DynamicResource Crntly.DangerHover}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Crntly.Danger}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Crntly.DangerPressed}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Crntly.DangerPressed}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.3" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Crntly.TitleButton" TargetType="Button" BasedOn="{StaticResource Crntly.Button}">
    <Setter Property="Foreground" Value="{DynamicResource Crntly.TextMuted}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="24" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="FontSize" Value="10" />
  </Style>

  <Style x:Key="Crntly.TextBox" TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource Crntly.Text}" />
    <Setter Property="Background" Value="{DynamicResource Crntly.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Crntly.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="{DynamicResource Crntly.ControlPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource Crntly.ControlHeight}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Crntly.AccentHover}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Crntly.Accent}" />
    <Setter Property="FontSize" Value="{DynamicResource Crntly.FontSize}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource Crntly.ControlRadius}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Crntly.BorderStrong}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Crntly.Accent}" />
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Crntly.SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Crntly.Background}" />
              <Setter Property="Foreground" Value="{DynamicResource Crntly.TextMuted}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBox" BasedOn="{StaticResource Crntly.TextBox}" />

  <!-- Compact rectangular switch: desktop-oriented rather than pill-shaped. -->
  <Style x:Key="Crntly.Toggle" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Crntly.Text}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{DynamicResource Crntly.FontSize}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="28" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Track"
                    Width="26" Height="14"
                    Background="{DynamicResource Crntly.BorderStrong}"
                    BorderBrush="{DynamicResource Crntly.BorderStrong}"
                    BorderThickness="1"
                    CornerRadius="2"
                    VerticalAlignment="Center">
              <Grid Margin="1">
                <Border x:Name="Thumb"
                        Width="10" Height="10"
                        Background="{DynamicResource Crntly.Text}"
                        CornerRadius="1"
                        HorizontalAlignment="Left" />
              </Grid>
            </Border>
            <ContentPresenter Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Crntly.Accent}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Crntly.Accent}" />
              <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Crntly.AccentHover}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="True" />
                <Condition Property="IsMouseOver" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Crntly.AccentHover}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Crntly.AccentHover}" />
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Crntly.AccentPressed}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Crntly.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Track" Property="Opacity" Value="0.36" />
              <Setter Property="Foreground" Value="{DynamicResource Crntly.TextSubtle}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="CheckBox" BasedOn="{StaticResource Crntly.Toggle}" />

  <Style x:Key="Crntly.Slider" TargetType="Slider">
    <Setter Property="Foreground" Value="{DynamicResource Crntly.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Crntly.Border}" />
    <Setter Property="Height" Value="16" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Height="16">
            <Border Height="2" Background="{TemplateBinding Background}" VerticalAlignment="Center" />
            <Track x:Name="PART_Track"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value}"
                   Orientation="{TemplateBinding Orientation}"
                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                   VerticalAlignment="Center">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="{DynamicResource Crntly.Accent}" Focusable="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Height="2" Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="9" Height="13" Focusable="False">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="ThumbChrome"
                              Background="{DynamicResource Crntly.Text}"
                              BorderBrush="{DynamicResource Crntly.Accent}"
                              BorderThickness="1"
                              CornerRadius="1" />
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource Crntly.AccentHover}" />
                          <Setter TargetName="ThumbChrome" Property="BorderBrush" Value="{DynamicResource Crntly.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                          <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource Crntly.Accent}" />
                          <Setter TargetName="ThumbChrome" Property="BorderBrush" Value="White" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="Transparent" Focusable="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Slider" BasedOn="{StaticResource Crntly.Slider}" />

  <!-- Slim square-edged scrollbars. -->
  <ControlTemplate x:Key="Crntly.VerticalScrollBarTemplate" TargetType="ScrollBar">
    <Grid Width="{DynamicResource Crntly.ScrollBarSize}" Background="Transparent">
      <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" Opacity="0" />
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb MinHeight="20" Margin="1,1">
            <Thumb.Template>
              <ControlTemplate TargetType="Thumb">
                <Border x:Name="ThumbChrome" Background="{DynamicResource Crntly.BorderStrong}" CornerRadius="1" />
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource Crntly.AccentHover}" /></Trigger>
                  <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource Crntly.Accent}" /></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Thumb.Template>
          </Thumb>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" Opacity="0" />
        </Track.IncreaseRepeatButton>
      </Track>
    </Grid>
  </ControlTemplate>

  <ControlTemplate x:Key="Crntly.HorizontalScrollBarTemplate" TargetType="ScrollBar">
    <Grid Height="{DynamicResource Crntly.ScrollBarSize}" Background="Transparent">
      <Track x:Name="PART_Track" IsDirectionReversed="False" Focusable="False">
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" Opacity="0" />
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb MinWidth="20" Margin="1,1">
            <Thumb.Template>
              <ControlTemplate TargetType="Thumb">
                <Border x:Name="ThumbChrome" Background="{DynamicResource Crntly.BorderStrong}" CornerRadius="1" />
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource Crntly.AccentHover}" /></Trigger>
                  <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource Crntly.Accent}" /></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Thumb.Template>
          </Thumb>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" Opacity="0" />
        </Track.IncreaseRepeatButton>
      </Track>
    </Grid>
  </ControlTemplate>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="{DynamicResource Crntly.ScrollBarSize}" />
    <Setter Property="Height" Value="{DynamicResource Crntly.ScrollBarSize}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template" Value="{StaticResource Crntly.VerticalScrollBarTemplate}" />
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Template" Value="{StaticResource Crntly.HorizontalScrollBarTemplate}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
  </Style>

  <Style TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border x:Name="Row"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{DynamicResource Crntly.Border}"
                    BorderThickness="1"
                    CornerRadius="1"
                    Padding="7,4,6,4">
              <ContentPresenter />
            </Border>
            <Border x:Name="AccentBar"
                    Width="2"
                    Margin="0,3,0,3"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    CornerRadius="1" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource Crntly.SurfaceHover}" />
              <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Crntly.BorderStrong}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Crntly.Accent}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource Crntly.AccentMuted}" />
              <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Crntly.BorderStrong}" />
              <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource Crntly.Accent}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True" />
                <Condition Property="IsMouseOver" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Crntly.Accent}" />
              <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource Crntly.AccentHover}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value="0.4" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
