<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Dependency-free CRNTLY component system. Kept local to the UI DLL. -->
  <Color x:Key="Crntly.BackgroundColor">#09090B</Color>
  <Color x:Key="Crntly.SurfaceColor">#111114</Color>
  <Color x:Key="Crntly.SurfaceRaisedColor">#18181C</Color>
  <Color x:Key="Crntly.SurfaceHoverColor">#202026</Color>
  <Color x:Key="Crntly.BorderColor">#29292F</Color>
  <Color x:Key="Crntly.BorderStrongColor">#3A3A43</Color>
  <Color x:Key="Crntly.TextColor">#FAFAFA</Color>
  <Color x:Key="Crntly.TextMutedColor">#A1A1AA</Color>
  <Color x:Key="Crntly.TextSubtleColor">#71717A</Color>
  <Color x:Key="Crntly.AccentColor">#8B5CF6</Color>
  <Color x:Key="Crntly.AccentHoverColor">#9F7AEA</Color>
  <Color x:Key="Crntly.AccentPressedColor">#7C3AED</Color>
  <Color x:Key="Crntly.AccentMutedColor">#241B37</Color>
  <Color x:Key="Crntly.SuccessColor">#34D399</Color>
  <Color x:Key="Crntly.DangerColor">#FB7185</Color>
  <Color x:Key="Crntly.DangerMutedColor">#321820</Color>

  <SolidColorBrush x:Key="Crntly.Background" Color="{StaticResource Crntly.BackgroundColor}" />
  <SolidColorBrush x:Key="Crntly.Surface" Color="{StaticResource Crntly.SurfaceColor}" />
  <SolidColorBrush x:Key="Crntly.SurfaceRaised" Color="{StaticResource Crntly.SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="Crntly.SurfaceHover" Color="{StaticResource Crntly.SurfaceHoverColor}" />
  <SolidColorBrush x:Key="Crntly.Border" Color="{StaticResource Crntly.BorderColor}" />
  <SolidColorBrush x:Key="Crntly.BorderStrong" Color="{StaticResource Crntly.BorderStrongColor}" />
  <SolidColorBrush x:Key="Crntly.Text" Color="{StaticResource Crntly.TextColor}" />
  <SolidColorBrush x:Key="Crntly.TextMuted" Color="{StaticResource Crntly.TextMutedColor}" />
  <SolidColorBrush x:Key="Crntly.TextSubtle" Color="{StaticResource Crntly.TextSubtleColor}" />
  <SolidColorBrush x:Key="Crntly.Accent" Color="{StaticResource Crntly.AccentColor}" />
  <SolidColorBrush x:Key="Crntly.AccentHover" Color="{StaticResource Crntly.AccentHoverColor}" />
  <SolidColorBrush x:Key="Crntly.AccentPressed" Color="{StaticResource Crntly.AccentPressedColor}" />
  <SolidColorBrush x:Key="Crntly.AccentMuted" Color="{StaticResource Crntly.AccentMutedColor}" />
  <SolidColorBrush x:Key="Crntly.Success" Color="{StaticResource Crntly.SuccessColor}" />
  <SolidColorBrush x:Key="Crntly.Danger" Color="{StaticResource Crntly.DangerColor}" />
  <SolidColorBrush x:Key="Crntly.DangerMuted" Color="{StaticResource Crntly.DangerMutedColor}" />

  <Style TargetType="Window">
    <Setter Property="Background" Value="{StaticResource Crntly.Background}" />
    <Setter Property="Foreground" Value="{StaticResource Crntly.Text}" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
  </Style>

  <Style x:Key="Crntly.Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Crntly.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Crntly.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
  </Style>

  <Style x:Key="Crntly.SubtleCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Crntly.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{StaticResource Crntly.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>

  <Style x:Key="Crntly.Label" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Crntly.TextMuted}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="Crntly.Button" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Crntly.Text}" />
    <Setter Property="Background" Value="{StaticResource Crntly.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{StaticResource Crntly.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="13,7" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Crntly.SurfaceHover}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Crntly.BorderStrong}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Crntly.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Crntly.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Crntly.Button}">
    <Setter Property="Background" Value="{StaticResource Crntly.Accent}" />
    <Setter Property="BorderBrush" Value="{StaticResource Crntly.Accent}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Crntly.AccentHover}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Crntly.AccentHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Crntly.AccentPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Crntly.DangerButton" TargetType="Button" BasedOn="{StaticResource Crntly.Button}">
    <Setter Property="Foreground" Value="{StaticResource Crntly.Danger}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style x:Key="Crntly.TitleButton" TargetType="Button" BasedOn="{StaticResource Crntly.Button}">
    <Setter Property="Foreground" Value="{StaticResource Crntly.TextMuted}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="MinHeight" Value="30" />
  </Style>

  <Style x:Key="Crntly.TextBox" TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource Crntly.Text}" />
    <Setter Property="Background" Value="{StaticResource Crntly.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{StaticResource Crntly.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="CaretBrush" Value="{StaticResource Crntly.Text}" />
    <Setter Property="SelectionBrush" Value="{StaticResource Crntly.Accent}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Crntly.Accent}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Crntly.BorderStrong}" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="#0E0E11" />
              <Setter Property="Foreground" Value="{StaticResource Crntly.TextMuted}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBox" BasedOn="{StaticResource Crntly.TextBox}" />

  <Style x:Key="Crntly.Toggle" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Crntly.Text}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="36" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Track"
                    Width="34" Height="18"
                    Background="{StaticResource Crntly.BorderStrong}"
                    CornerRadius="9"
                    VerticalAlignment="Center">
              <Grid Margin="2">
                <Ellipse x:Name="Thumb"
                         Width="14" Height="14"
                         Fill="{StaticResource Crntly.Text}"
                         HorizontalAlignment="Left" />
              </Grid>
            </Border>
            <ContentPresenter Grid.Column="2"
                              Margin="8,0,0,0"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{StaticResource Crntly.Accent}" />
              <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="Opacity" Value="0.9" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Track" Property="Opacity" Value="0.4" />
              <Setter Property="Foreground" Value="{StaticResource Crntly.TextSubtle}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="CheckBox" BasedOn="{StaticResource Crntly.Toggle}" />

  <Style x:Key="Crntly.Slider" TargetType="Slider">
    <Setter Property="Foreground" Value="{StaticResource Crntly.Accent}" />
    <Setter Property="Background" Value="{StaticResource Crntly.Border}" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Height="22">
            <Border Height="4"
                    Background="{TemplateBinding Background}"
                    CornerRadius="2"
                    VerticalAlignment="Center" />
            <Track x:Name="PART_Track"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value}"
                   Orientation="{TemplateBinding Orientation}"
                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                   VerticalAlignment="Center">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                              Background="{TemplateBinding Foreground}"
                              Focusable="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Height="4"
                              Background="{TemplateBinding Background}"
                              CornerRadius="2" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="14" Height="14" Focusable="False">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Ellipse x:Name="ThumbCircle"
                               Fill="{StaticResource Crntly.Text}"
                               Stroke="{StaticResource Crntly.Accent}"
                               StrokeThickness="2" />
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="ThumbCircle" Property="Fill" Value="White" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                              Background="Transparent"
                              Focusable="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Background="Transparent" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Slider" BasedOn="{StaticResource Crntly.Slider}" />

  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
  </Style>

  <Style TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Row"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{StaticResource Crntly.Border}"
                  BorderThickness="1"
                  CornerRadius="7"
                  Padding="10,9">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{StaticResource Crntly.SurfaceHover}" />
              <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Crntly.BorderStrong}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{StaticResource Crntly.AccentMuted}" />
              <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Crntly.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Row" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
