<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- CRNTLY Streamer.bot palette. Keep brand colors centralized here. -->
  <Color x:Key="Crntly.BackgroundColor">#111216</Color>
  <Color x:Key="Crntly.SurfaceColor">#181A20</Color>
  <Color x:Key="Crntly.SurfaceRaisedColor">#20232B</Color>
  <Color x:Key="Crntly.BorderColor">#30343E</Color>
  <Color x:Key="Crntly.TextColor">#F5F6F8</Color>
  <Color x:Key="Crntly.TextMutedColor">#9DA3AF</Color>
  <Color x:Key="Crntly.AccentColor">#8B3DFF</Color>
  <Color x:Key="Crntly.AccentHoverColor">#9D5CFF</Color>
  <Color x:Key="Crntly.SuccessColor">#42D392</Color>
  <Color x:Key="Crntly.DangerColor">#FF5C70</Color>

  <SolidColorBrush x:Key="Crntly.Background" Color="{StaticResource Crntly.BackgroundColor}" />
  <SolidColorBrush x:Key="Crntly.Surface" Color="{StaticResource Crntly.SurfaceColor}" />
  <SolidColorBrush x:Key="Crntly.SurfaceRaised" Color="{StaticResource Crntly.SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="Crntly.Border" Color="{StaticResource Crntly.BorderColor}" />
  <SolidColorBrush x:Key="Crntly.Text" Color="{StaticResource Crntly.TextColor}" />
  <SolidColorBrush x:Key="Crntly.TextMuted" Color="{StaticResource Crntly.TextMutedColor}" />
  <SolidColorBrush x:Key="Crntly.Accent" Color="{StaticResource Crntly.AccentColor}" />
  <SolidColorBrush x:Key="Crntly.AccentHover" Color="{StaticResource Crntly.AccentHoverColor}" />
  <SolidColorBrush x:Key="Crntly.Success" Color="{StaticResource Crntly.SuccessColor}" />
  <SolidColorBrush x:Key="Crntly.Danger" Color="{StaticResource Crntly.DangerColor}" />

  <Style TargetType="Window">
    <Setter Property="Background" Value="{StaticResource Crntly.Background}" />
    <Setter Property="Foreground" Value="{StaticResource Crntly.Text}" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <Style x:Key="Crntly.Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Crntly.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Crntly.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <Style x:Key="Crntly.Button" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Crntly.Text}" />
    <Setter Property="Background" Value="{StaticResource Crntly.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{StaticResource Crntly.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="7"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="#2A2E38" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Crntly.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Crntly.Button}">
    <Setter Property="Background" Value="{StaticResource Crntly.Accent}" />
    <Setter Property="BorderBrush" Value="{StaticResource Crntly.Accent}" />
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource Crntly.Text}" />
    <Setter Property="Background" Value="{StaticResource Crntly.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{StaticResource Crntly.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="CaretBrush" Value="{StaticResource Crntly.Text}" />
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Crntly.Text}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <Style TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,7" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="SelectionBorder"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{StaticResource Crntly.Border}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="10">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="SelectionBorder" Property="Background" Value="#20232B" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="SelectionBorder" Property="Background" Value="#292138" />
              <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{StaticResource Crntly.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
