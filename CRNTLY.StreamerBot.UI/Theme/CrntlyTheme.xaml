<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- CRNTLY: neutral, compact, shadcn-inspired surfaces over ModernWPF controls. -->
  <Color x:Key="Crntly.BackgroundColor">#0B0B0F</Color>
  <Color x:Key="Crntly.SurfaceColor">#111116</Color>
  <Color x:Key="Crntly.SurfaceRaisedColor">#18181F</Color>
  <Color x:Key="Crntly.SurfaceHoverColor">#202028</Color>
  <Color x:Key="Crntly.BorderColor">#292933</Color>
  <Color x:Key="Crntly.BorderStrongColor">#3B3B48</Color>
  <Color x:Key="Crntly.TextColor">#FAFAFA</Color>
  <Color x:Key="Crntly.TextMutedColor">#A1A1AA</Color>
  <Color x:Key="Crntly.TextSubtleColor">#71717A</Color>
  <Color x:Key="Crntly.AccentColor">#8B5CF6</Color>
  <Color x:Key="Crntly.AccentHoverColor">#9F7AEA</Color>
  <Color x:Key="Crntly.AccentMutedColor">#261B3F</Color>
  <Color x:Key="Crntly.SuccessColor">#34D399</Color>
  <Color x:Key="Crntly.DangerColor">#FB7185</Color>

  <SolidColorBrush x:Key="Crntly.Background" Color="{StaticResource Crntly.BackgroundColor}" />
  <SolidColorBrush x:Key="Crntly.Surface" Color="{StaticResource Crntly.SurfaceColor}" />
  <SolidColorBrush x:Key="Crntly.SurfaceRaised" Color="{StaticResource Crntly.SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="Crntly.SurfaceHover" Color="{StaticResource Crntly.SurfaceHoverColor}" />
  <SolidColorBrush x:Key="Crntly.Border" Color="{StaticResource Crntly.BorderColor}" />
  <SolidColorBrush x:Key="Crntly.BorderStrong" Color="{StaticResource Crntly.BorderStrongColor}" />
  <SolidColorBrush x:Key="Crntly.Text" Color="{StaticResource Crntly.TextColor}" />
  <SolidColorBrush x:Key="Crntly.TextMuted" Color="{StaticResource Crntly.TextMutedColor}" />
  <SolidColorBrush x:Key="Crntly.TextSubtle" Color="{StaticResource Crntly.TextSubtleColor}" />
  <SolidColorBrush x:Key="Crntly.Accent" Color="{StaticResource Crntly.AccentColor}" />
  <SolidColorBrush x:Key="Crntly.AccentHover" Color="{StaticResource Crntly.AccentHoverColor}" />
  <SolidColorBrush x:Key="Crntly.AccentMuted" Color="{StaticResource Crntly.AccentMutedColor}" />
  <SolidColorBrush x:Key="Crntly.Success" Color="{StaticResource Crntly.SuccessColor}" />
  <SolidColorBrush x:Key="Crntly.Danger" Color="{StaticResource Crntly.DangerColor}" />

  <Style x:Key="Crntly.Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Crntly.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Crntly.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
  </Style>

  <Style x:Key="Crntly.SubtleCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Crntly.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{StaticResource Crntly.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>

  <Style x:Key="Crntly.Label" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Crntly.TextMuted}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <Style x:Key="Crntly.Button"
         TargetType="Button"
         BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="{StaticResource Crntly.Text}" />
    <Setter Property="Background" Value="{StaticResource Crntly.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{StaticResource Crntly.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="13,7" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style x:Key="Crntly.PrimaryButton"
         TargetType="Button"
         BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Background" Value="{StaticResource Crntly.Accent}" />
    <Setter Property="BorderBrush" Value="{StaticResource Crntly.Accent}" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style x:Key="Crntly.DangerButton"
         TargetType="Button"
         BasedOn="{StaticResource Crntly.Button}">
    <Setter Property="Foreground" Value="{StaticResource Crntly.Danger}" />
  </Style>

  <Style x:Key="Crntly.TitleButton"
         TargetType="Button"
         BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="{StaticResource Crntly.TextMuted}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style x:Key="Crntly.TextBox"
         TargetType="TextBox"
         BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Foreground" Value="{StaticResource Crntly.Text}" />
    <Setter Property="Background" Value="{StaticResource Crntly.SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{StaticResource Crntly.Border}" />
    <Setter Property="CaretBrush" Value="{StaticResource Crntly.Text}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="MinHeight" Value="34" />
  </Style>

  <Style x:Key="Crntly.ReadOnlyTextBox"
         TargetType="TextBox"
         BasedOn="{StaticResource Crntly.TextBox}">
    <Setter Property="Foreground" Value="{StaticResource Crntly.TextMuted}" />
    <Setter Property="Background" Value="#0E0E13" />
  </Style>

  <Style x:Key="Crntly.OverlayList"
         TargetType="ListBox"
         BasedOn="{StaticResource {x:Type ListBox}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
  </Style>

  <Style x:Key="Crntly.OverlayListItem" TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Row"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{StaticResource Crntly.Border}"
                  BorderThickness="1"
                  CornerRadius="7"
                  Padding="10,9">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{StaticResource Crntly.SurfaceHover}" />
              <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Crntly.BorderStrong}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{StaticResource Crntly.AccentMuted}" />
              <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Crntly.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Row" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
