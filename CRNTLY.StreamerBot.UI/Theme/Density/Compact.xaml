<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- Dense desktop-tool geometry. Swap this dictionary without changing controls. -->
  <sys:Double x:Key="Crntly.ControlHeight">24</sys:Double>
  <sys:Double x:Key="Crntly.SmallControlHeight">21</sys:Double>
  <GridLength x:Key="Crntly.TitleBarHeight">30</GridLength>
  <sys:Double x:Key="Crntly.ScrollBarSize">6</sys:Double>
  <sys:Double x:Key="Crntly.FontSize">10</sys:Double>
  <sys:Double x:Key="Crntly.SmallFontSize">9</sys:Double>
  <sys:Double x:Key="Crntly.TitleFontSize">13</sys:Double>

  <Thickness x:Key="Crntly.WindowMargin">7</Thickness>
  <Thickness x:Key="Crntly.CardPadding">7</Thickness>
  <Thickness x:Key="Crntly.ControlPadding">6,2</Thickness>
  <Thickness x:Key="Crntly.ButtonPadding">8,2</Thickness>
  <Thickness x:Key="Crntly.CompactButtonPadding">6,1</Thickness>
  <Thickness x:Key="Crntly.FieldGap">0,0,0,6</Thickness>
  <Thickness x:Key="Crntly.SectionGap">0,0,0,7</Thickness>

  <CornerRadius x:Key="Crntly.WindowRadius">3</CornerRadius>
  <CornerRadius x:Key="Crntly.CardRadius">2</CornerRadius>
  <CornerRadius x:Key="Crntly.ControlRadius">2</CornerRadius>
</ResourceDictionary>
